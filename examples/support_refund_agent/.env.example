# AgentDNA
AGENTDNA_API_KEY=
PROVENANCE_LAYER_URL=https://chain-connector-2.rubix.net
ADMIN_SERVER_URL=https://agentdna-admin.agentdna.io
CBAC_URL=https://cbac-service.agentdna.io
SUPPORT_LEAD_NAME=support-lead
SUPPORT_AGENT_NAME=Support Agent
PAYMENTS_AGENT_NAME=Payments Agent
GATEWAY_NAME=Gateway
# Authentication evidence (optional): shows Stripe and Jira on the dashboard,
AGENTDNA_AUTH_EVIDENCE=
AGENTDNA_FINGERPRINT_KEY=

# LLM: ollama, openai or gemini
LLM_BACKEND=ollama
OLLAMA_MODEL=llama3.1
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Stripe (test mode). Only Kong uses it, and make_payment.py for setup.
STRIPE_AUTH=Bearer sk_test_...
STRIPE_PAYMENT_INTENT=

# Jira Cloud. Only Kong uses it. JIRA_AUTH: "Basic " + base64 of "email:api_token"
JIRA_AUTH=Basic ...
JIRA_PROJECT=KAN
