# --- Gemini (through Google ADK) -----------------------------------------------
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GEMINI_MODEL=gemini-2.5-flash

# --- Travel MCP server ------------------------------------------------------------
# Its tools use public data that needs no API key.
TRAVEL_MCP_URL=http://127.0.0.1:8660/mcp
MCP_HOST=127.0.0.1
MCP_PORT=8660
HTTP_TIMEOUT_SECONDS=20

# --- AgentDNA ------------------------------------------------------------------
AGENTDNA_API_KEY=
PROVENANCE_LAYER_URL=
ADMIN_SERVER_URL=

USER_NAME=
COORDINATOR_AGENT_NAME=travel-coordinator
WEATHER_AGENT_NAME=travel-weather-agent
DESTINATION_AGENT_NAME=travel-destination-agent
MONEY_AGENT_NAME=travel-money-agent
MCP_SERVER_NAME=travel-mcp
