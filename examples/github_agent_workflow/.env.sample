# Select the LLM provider to use. 
# Options: "gemini", "ollama", "openai"
LLM_PROVIDER=openai

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TEMPERATURE=0.1

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# OpenAI / OpenAI-compatible
OPENAI_API_KEY=
OPENAI_MODEL=qwen3-coder:30b
# Optional for OpenAI-compatible providers. If not set, defaults to OpenAI's API.
# Must include the /v1 root — the OpenAI client appends /chat/completions to it.
OPENAI_BASE_URL=https://llm.agentdna.io/v1

# GitHub
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com

# MCP
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8765

# AgentDNA Beta API Key 
AGENTDNA_API_KEY=
