LLM_PROVIDER=gemini

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TEMPERATURE=0.1

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# GitHub
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com

# MCP
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8765

# AgentDNA
AGENTDNA_API_KEY=
AGENTDNA_CHAIN_URL=http://localhost:20001
AGENTDNA_CBAC_URL=
ORGANISATION_ID=

# CBAC
CBAC_TIMEOUT_SECONDS=3600

# Default CLI user identity
GITHUB_AGENT_USER_EMAIL=user@example.com

# Agent names
AGENT_COORDINATOR=coordinator_agent
AGENT_WORKER=worker_agent