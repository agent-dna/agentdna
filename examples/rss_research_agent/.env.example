# --- LLM backend --------------------------------------------------------------
LLM_BACKEND=ollama
LLM_TEMPERATURE=0
LLM_REQUEST_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=4

# ollama (local models)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1

# gemini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- RSS and MCP --------------------------------------------------------------
RSS_MCP_URL=http://127.0.0.1:8013/mcp
MCP_HOST=127.0.0.1
MCP_PORT=8013
MCP_TOOL_TIMEOUT_SECONDS=30
RSS_CACHE_DATABASE=data/rss_cache.db
RSS_FEEDS_JSON=[{"id":"cisa","name":"CISA Alerts","url":"https://www.cisa.gov/cybersecurity-advisories/all.xml"},{"id":"github","name":"GitHub Blog","url":"https://github.blog/feed/"}]
RSS_RESEARCH_TASK=Research material developments relevant to security and technology teams.

# AgentDNA related env variables

AGENTDNA_API_KEY=
PROVENANCE_LAYER_URL=

USER_NAME=
RSS_ORCHESTRATOR_AGENT_NAME=
RSS_TECHNOLOGY_AGENT_NAME=
RSS_SECURITY_AGENT_NAME=

ADMIN_SERVER_URL=