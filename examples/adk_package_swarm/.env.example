# --- Gemini (through Google ADK) -----------------------------------------------
GOOGLE_API_KEY=
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GEMINI_MODEL=gemini-2.5-flash

# --- Package-intelligence MCP server ---------------------------------------------
# Its tools use public data that needs no API key.
PACKAGE_MCP_URL=http://127.0.0.1:8680/mcp
MCP_HOST=127.0.0.1
MCP_PORT=8680
HTTP_TIMEOUT_SECONDS=30

# --- AgentDNA ------------------------------------------------------------------
AGENTDNA_API_KEY=
PROVENANCE_LAYER_URL=
ADMIN_SERVER_URL=

USER_NAME=
COORDINATOR_AGENT_NAME=package-coordinator
PACKAGE_AGENT_NAME=package-agent
SECURITY_AGENT_NAME=package-security-agent
ECOSYSTEM_AGENT_NAME=package-ecosystem-agent
MCP_SERVER_NAME=package-intelligence-mcp
