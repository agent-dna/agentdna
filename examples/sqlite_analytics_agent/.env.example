# --- LLM backend --------------------------------------------------------------
LLM_BACKEND=ollama
LLM_TEMPERATURE=0

# ollama (local models)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1

# openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# gemini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- SQLite -------------------------------------------------------------------
SQLITE_DATABASE_PATH=data/analytics.db

# --- SQLite MCP server ----------------------------------------------------------
SQLITE_MCP_URL=http://127.0.0.1:8544/mcp
MCP_HOST=127.0.0.1
MCP_PORT=8544

# AgentDNA related env variables
AGENTDNA_API_KEY=
PROVENANCE_LAYER_URL=
ADMIN_SERVER_URL=

USER_NAME=
SQLITE_AGENT_NAME=
MCP_SERVER_NAME=
# Headers the agent sends to the MCP server. Used to give a run a credential
# for AgentDNA's authentication evidence to observe.
# SQLITE_MCP_HEADERS={"Authorization": "Bearer <token>"}
SQLITE_MCP_HEADERS=

# CBAC decision service. Leave empty for the default (production) service.
CBAC_URL=

# AgentDNA authentication evidence (MCP server process)
# AGENTDNA_FINGERPRINT_KEY : one value across the deployment
# AGENTDNA_AUTH_EVIDENCE_FILE : where records are written; unset disables it
AGENTDNA_FINGERPRINT_KEY=
AGENTDNA_AUTH_EVIDENCE_FILE=
