# --- LLM backend --------------------------------------------------------------
LLM_BACKEND=ollama
LLM_TEMPERATURE=0

# ollama (local models)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1

# openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# gemini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- SQLite -------------------------------------------------------------------
SQLITE_DATABASE_PATH=data/analytics.db
SQLITE_ANALYSIS_TASK=Analyse recent business activity, unusual trends, high-performing products, and recommendations.

# AgentDNA related env variables
AGENTDNA_API_KEY=
PROVENANCE_LAYER_URL=

USER_NAME=
SQLITE_AGENT_NAME=
