# --- LLM backend --------------------------------------------------------------
LLM_BACKEND=ollama
LLM_TEMPERATURE=0

# ollama (local models)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1

# openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# gemini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- GitHub and MCP -----------------------------------------------------------
GITHUB_TOKEN=
GITHUB_REPOSITORY_OWNER=
GITHUB_REPOSITORY_NAME=
GITHUB_MCP_URL=http://127.0.0.1:8011/mcp
MCP_HOST=127.0.0.1
MCP_PORT=8011
MCP_TOOL_TIMEOUT_SECONDS=30
GITHUB_ANALYSIS_TASK=Analyse recent repository activity, important changes, risks, issues, and pull requests.

# AgentDNA related env variables

AGENTDNA_API_KEY=
PROVENANCE_LAYER_URL=

USER_NAME=
GITHUB_AGENT_NAME=
ADMIN_SERVER_URL=