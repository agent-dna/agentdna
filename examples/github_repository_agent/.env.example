# --- LLM backend --------------------------------------------------------------
LLM_BACKEND=ollama
LLM_TEMPERATURE=0

# ollama (local models)
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1

# openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=

# gemini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- GitHub and MCP -----------------------------------------------------------
GITHUB_TOKEN=
GITHUB_REPOSITORY_OWNER=
GITHUB_REPOSITORY_NAME=
MCP_HOST=127.0.0.1
MCP_PORT=8011
MCP_TOOL_TIMEOUT_SECONDS=30
GITHUB_ANALYSIS_TASK=Analyse recent repository activity, important changes, risks, issues, and pull requests.

# --- AgentDNA -----------------------------------------------------------------
# Read by this application and by the AgentDNA MCP Gateway, which signs MCP tool
# calls as AGENTDNA_AGENT_NAME. Both must use the same values.
AGENTDNA_API_KEY=
AGENTDNA_PROVENANCE_LAYER_URL=
AGENTDNA_AGENT_NAME=

USER_NAME=
ADMIN_SERVER_URL=

# --- AgentDNA MCP Gateway -------------------------------------------------------
# The agent reaches the GitHub MCP server only through the gateway.
AGENTDNA_GATEWAY_URL=http://127.0.0.1:8090
AGENTDNA_GATEWAY_PORT=8090
# Where the gateway forwards to: this project's MCP server (MCP_HOST/MCP_PORT).
AGENTDNA_GATEWAY_UPSTREAM_URL=http://127.0.0.1:8011/mcp
# Optional. When set, the gateway requires it to open and close runs.
AGENTDNA_GATEWAY_TOKEN=
