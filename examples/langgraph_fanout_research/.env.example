# --- Gemini (through langchain-google-genai) -----------------------------------
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0

# --- Fan-out -------------------------------------------------------------------
# The most workers the orchestrator may spawn for one question.
MAX_WORKERS=4

# --- Research MCP server ---------------------------------------------------------
# Its tools use public data that needs no API key.
RESEARCH_MCP_URL=http://127.0.0.1:8670/mcp
MCP_HOST=127.0.0.1
MCP_PORT=8670
HTTP_TIMEOUT_SECONDS=45

# --- Wikipedia -------------------------------------------------------------------
# A URL or email to reach you by. Wikimedia blocks API clients that send none
# (403 "Please respect our robot policy").
CONTACT=
# The most Wikipedia requests in flight at once, across every worker.
WIKIPEDIA_CONCURRENCY=2

# --- AgentDNA ------------------------------------------------------------------
AGENTDNA_API_KEY=
PROVENANCE_LAYER_URL=
ADMIN_SERVER_URL=

USER_NAME=
ORCHESTRATOR_AGENT_NAME=research-orchestrator
MCP_SERVER_NAME=research-mcp

# CBAC decision service. Leave empty for the default (production) service.
CBAC_URL=
